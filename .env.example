# Copy to `.env.local` and set to your backend origin to switch from the built-in
# mock data to a live REST API. Leave empty (or unset) to run fully static.
#
# When set, the app calls:
#   GET  {VITE_API_BASE_URL}/api/projects
#   GET  {VITE_API_BASE_URL}/api/blog
#   GET  {VITE_API_BASE_URL}/api/resume
#   GET  {VITE_API_BASE_URL}/api/visitor-count
#   POST {VITE_API_BASE_URL}/api/chat
VITE_API_BASE_URL=

# --- AI assistant (OpenAI) -------------------------------------------------
# Point the AliciaAI chat at the serverless endpoint in /api/chat.ts.
# Same-origin deploy (Vercel/Netlify): use "/api/chat".
# Leave empty to use the built-in offline mock replies.
VITE_CHAT_API_URL=

# NOTE: the OpenAI secret is NOT set here — it must never reach the browser.
# Set OPENAI_API_KEY as a SERVER env var in your host's dashboard
# (Vercel/Netlify → Project → Settings → Environment Variables).
# For local testing of the function, put it in `.env.local` too:
# OPENAI_API_KEY=sk-...
